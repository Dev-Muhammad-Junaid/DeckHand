<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Pixel Hand</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <!-- Run as menu bar app (no Dock icon) -->
    <key>LSUIElement</key>
    <true/>
    <!-- Sentry DSN, from the SENTRY_DSN build setting in project.yml.
         Empty turns crash reporting off. -->
    <key>SentryDSN</key>
    <string>$(SENTRY_DSN)</string>
    <!-- Sparkle updates (Release/RELEASING.md). Values come from project.yml. -->
    <key>SUFeedURL</key>
    <string>$(SPARKLE_FEED_URL)</string>
    <key>SUPublicEDKey</key>
    <string>$(SPARKLE_PUBLIC_ED_KEY)</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <!-- Bonjour discovery -->
    <key>NSBonjourServices</key>
    <array>
        <string>_pixelhand._tcp</string>
    </array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Pixel Hand uses the local network to discover and receive connections from nearby iPads.</string>
    <!-- Accessibility usage (for CGEvent injection) -->
    <key>NSAccessibilityUsageDescription</key>
    <string>Pixel Hand needs Accessibility access to control the cursor and keyboard on behalf of your iPad.</string>
    <!-- Screen Recording usage (ScreenCaptureKit) — required on macOS 14+/26 Tahoe -->
    <key>NSScreenCaptureUsageDescription</key>
    <string>Pixel Hand captures your Mac screen so your iPad can preview it on demand.</string>
</dict>
</plist>
