<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same-iCloud device awareness. Enabled now that com.widgetsflow.pixelhand is
	     registered under the Mega Creations LLC team with the CloudKit
	     capability turned on (see DeckHandCloud.isCloudEnabled). -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.widgetsflow.pixelhand</string>
	</array>
	<!-- App Intents lane: the widget extension reads the deck snapshot and
	     queues intents here (PixelHandAppGroup). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.widgetsflow.pixelhand</string>
	</array>
</dict>
</plist>
